# rhino.fi API base. Optional; defaults to https://api.rhino.fi when unset.
RHINO_API_BASE=https://api.rhino.fi

# Anthropic key for the internal BD workspace (/workspace) and the AI demand brief
# on /insights. Optional: with no key set, those AI features report themselves as
# unconfigured and the rest of the app is unaffected.
ANTHROPIC_API_KEY=

# Model for the AI workspace. Defaults to claude-opus-5. Set claude-sonnet-5 or
# claude-haiku-4-5 for a cheaper, faster tier on a high-volume desk.
ANTHROPIC_MODEL=claude-opus-5

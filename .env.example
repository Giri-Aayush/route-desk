# rhino.fi API base. Optional; defaults to https://api.rhino.fi when unset.
RHINO_API_BASE=https://api.rhino.fi

# AI workspace (/workspace) and the AI demand brief (/insights). Choose the provider:
# "anthropic" (default) or "nvidia" for any OpenAI-compatible endpoint, which covers
# NVIDIA NIMs on build.nvidia.com, a self-hosted NIM, OpenRouter, and similar. With
# no key for the active provider, the AI features report themselves as unconfigured
# and the rest of the app is unaffected.
AI_PROVIDER=anthropic

# Anthropic (AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# OpenAI-compatible endpoint (AI_PROVIDER=nvidia)
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
